<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: package.sh substitutes @APP_ID@, @VERSION@ (full, e.g. 0.5.0-rc.1),
     @SHORT_VERSION@ (numeric X.Y.Z) and @BUILD_SHA@. Adapted from SoundCraft
     (storytold/soundcraft, Apache-2.0), see NOTICE. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>StudioCraft</string>
  <key>CFBundleName</key>
  <string>StudioCraft</string>
  <key>CFBundleExecutable</key>
  <string>StudioCraft</string>
  <key>CFBundleIdentifier</key>
  <string>@APP_ID@</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>StudioCraftVersion</key>
  <string>@VERSION@</string>
  <key>StudioCraftBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>StudioCraft</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.music</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <!-- Shown by macOS the first time StudioCraft opens an input device (recording). -->
  <key>NSMicrophoneUsageDescription</key>
  <string>StudioCraft records audio from the inputs you choose.</string>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © StudioCraft contributors. MIT OR Apache-2.0.</string>
  <!-- Finder hands documents over as an "open documents" event; apps/studiocraft/src/macos_open.rs
       receives it. -->
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>@APP_ID@.project</string>
      <key>UTTypeDescription</key>
      <string>StudioCraft Project</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.json</string>
        <string>public.data</string>
      </array>
      <key>UTTypeIconFile</key>
      <string>StudioCraft</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>studiocraft</string></array>
        <key>public.mime-type</key>
        <array><string>application/x-studiocraft-project</string></array>
      </dict>
    </dict>
  </array>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>StudioCraft Project</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>CFBundleTypeIconFile</key>
      <string>StudioCraft</string>
      <key>LSItemContentTypes</key>
      <array><string>@APP_ID@.project</string></array>
    </dict>
    <!-- Audio: offered under "Open With" (imported as tracks), never the default player. -->
    <dict>
      <key>CFBundleTypeName</key>
      <string>Audio File</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.microsoft.waveform-audio</string>
        <string>public.aiff-audio</string>
        <string>public.aifc-audio</string>
        <string>org.xiph.flac</string>
        <string>public.mp3</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
