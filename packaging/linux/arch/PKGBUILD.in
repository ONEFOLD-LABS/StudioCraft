# Arch Linux package that repackages the StudioCraft release tarball (no Rust build inside
# makepkg). Generated by packaging/linux/arch-package.sh, which substitutes @VERSION@, @PKGVER@,
# @ARCH@, @TARBALL@ and @SHA256@.
pkgname=studiocraft
pkgver=@PKGVER@
pkgrel=1
pkgdesc="Digital audio workstation: record, arrange and mix music"
arch=('@ARCH@')
url="https://github.com/xXCrusaderXx/StudioCraft"
license=('MIT OR Apache-2.0')
depends=('glibc' 'gcc-libs' 'alsa-lib' 'libpipewire' 'libxkbcommon' 'hicolor-icon-theme')
optdepends=(
  'lilv: LV2 plugins'
  'vulkan-icd-loader: GPU rendering through Vulkan'
)
options=('!strip' '!debug')
source=("@TARBALL@")
sha256sums=('@SHA256@')

package() {
  cd "studiocraft-@VERSION@-linux-@ARCH@"
  install -Dm755 bin/studiocraft "$pkgdir/usr/bin/studiocraft"
  install -Dm755 bin/studiocraft-cli "$pkgdir/usr/bin/studiocraft-cli"
  install -d "$pkgdir/usr/share"
  cp -R share/applications share/metainfo share/mime share/icons "$pkgdir/usr/share/"
  install -d "$pkgdir/usr/share/doc"
  cp -R share/doc/studiocraft "$pkgdir/usr/share/doc/"
  install -Dm644 share/doc/studiocraft/LICENSE-MIT "$pkgdir/usr/share/licenses/studiocraft/LICENSE-MIT"
  install -Dm644 share/doc/studiocraft/LICENSE-APACHE "$pkgdir/usr/share/licenses/studiocraft/LICENSE-APACHE"
  install -Dm644 share/doc/studiocraft/THIRD-PARTY-LICENSES.txt "$pkgdir/usr/share/licenses/studiocraft/THIRD-PARTY-LICENSES.txt"
}
