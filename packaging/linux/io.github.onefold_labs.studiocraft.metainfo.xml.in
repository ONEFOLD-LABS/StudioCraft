<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.onefold_labs.studiocraft</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>StudioCraft</name>
  <summary>Record, arrange and mix music</summary>
  <summary xml:lang="de">Musik aufnehmen, arrangieren und mischen</summary>
  <developer id="io.github.onefold_labs">
    <name>StudioCraft contributors</name>
  </developer>
  <description>
    <p>StudioCraft is a digital audio workstation written in Rust. It records audio and MIDI,
      arranges events on tracks, mixes with groups, effect channels and CLAP plugins, and exports
      the mix as WAV, FLAC or AIFF.</p>
    <p xml:lang="de">StudioCraft ist eine Audio-Workstation in Rust. Sie nimmt Audio und MIDI auf,
      arrangiert Events auf Spuren, mischt mit Gruppen, FX-Kanälen und CLAP-Plugins und exportiert
      den Mix als WAV, FLAC oder AIFF.</p>
  </description>
  <url type="homepage">https://github.com/ONEFOLD-LABS/StudioCraft</url>
  <url type="bugtracker">https://github.com/ONEFOLD-LABS/StudioCraft/issues</url>
  <!-- App id until 0.7.0, before the move to ONEFOLD LABS. -->
  <replaces>
    <id>io.github.xxcrusaderxx.studiocraft</id>
  </replaces>
  <launchable type="desktop-id">io.github.onefold_labs.studiocraft.desktop</launchable>
  <icon type="stock">studiocraft</icon>
  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
  </categories>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
