<?xml version="1.0" encoding="UTF-8"?>
<!-- shared-mime-info definition for StudioCraft projects (open JSON). Audio types come from the
     system database. Installed to share/mime/packages/; update-mime-database runs on install. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-studiocraft-project">
    <comment>StudioCraft project</comment>
    <comment xml:lang="de">StudioCraft-Projekt</comment>
    <sub-class-of type="application/json"/>
    <icon name="studiocraft"/>
    <glob pattern="*.studiocraft"/>
  </mime-type>
</mime-info>
